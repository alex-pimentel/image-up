MAX_UPLOAD_MB=8
MAX_INPUT_PX=1000
OUTPUT_QUALITY=95
OUTPUT_FORMAT=webp
DEFAULT_SCALE=2

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=imageup:
CELERY_QUEUE=imageup
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL

# ML
USE_GPU=0
MODEL_NAME=RealESRGAN_x4plus
ENABLE_ML=1
FALLBACK_IF_UNAVAILABLE=1

# Storage
RESULT_TTL_SEC=3600
# Local disk fallback used when the R2_* credentials below are not set.
STORAGE_DIR=

# Cloudflare R2 (private tmp bucket, 24h lifecycle). Leave blank for local dev.
# NEVER commit real credentials.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_TMP=agenteresolve-tmp
# Short-lived presigned GET lifetime for results/uploads, in seconds.
R2_PRESIGN_EXPIRY_SEC=900

# Clerk (optional auth on POST /api/enhance). Leave blank to allow anonymous-only.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
# Upload limit for authenticated users (anonymous uses MAX_UPLOAD_MB).
AUTH_MAX_UPLOAD_MB=16